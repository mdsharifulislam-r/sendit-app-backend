  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:gateway": "nest start gateway",
    "start:gateway:dev": "nest start gateway --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/nest-js-template/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/nest-js-template/test/jest-e2e.json",
    "make-doc": "tsx scripts/make-doc.ts && tsx scripts/generate-swagger.ts && tsx scripts/generate-postman.ts",
    "stripe": "stripe listen --forward-to http://10.10.26.164:3004/api/v1/webhook"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
