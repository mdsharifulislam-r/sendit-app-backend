# Copied to /opt/sendit/.env on the EC2 box. Fill real values before/after first boot.

NODE_ENV=production
AWS_REGION=eu-central-1

# Optional — if set, apps load secrets via loadAwsSecrets() before Nest boots
# AWS_SECRET_NAME=sendit-ec2-dev-app-secret

# DocumentDB (from terraform output db_uri) + local Redis
# DB_URI=mongodb://USER:PASS@DOCDB_ENDPOINT:27017/sendit?tls=true&tlsCAFile=/app/certs/rds-global-bundle.pem&replicaSet=rs0&readPreference=primary&retryWrites=false&authMechanism=SCRAM-SHA-1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TLS=false

# Your existing SNS/SQS (same account as EC2)
# SNS_TOPIC_ARN=
# SNS_FIFO_TOPIC_ARN=
# SQS_QUEUE_URL=
# SQS_FIFO_QUEUE_URL=

# S3
# AWS_BUCKET_NAME=

# App secrets (or put these in Secrets Manager instead)
JWT_SECRET=change-me
JWT_EXPIRE_IN=7d
CORS_ORIGIN=*

# Required for root seedAdmin() — missing values crash the process
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=SuperSecureAdminPass123!

# Messaging (create in THIS AWS account — EC2 instance role must reach them)
# SNS_TOPIC_ARN=
# SNS_FIFO_TOPIC_ARN=
# SQS_QUEUE_URL=
# SQS_FIFO_QUEUE_URL=

# Stripe / Email / etc. (required or payment/communication will crash)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=
